{
  "release": "s1595",
  "date": "2026-11-17",
  "base": "s1586",
  "failed_start_fallback": "s1586",
  "change": {
    "snapshot_pool": "conversation snapshots (cache entries, paused requests) map 16 MiB chunks of a pool created once after warm-up (8 GiB a device) instead of allocating while serving. Snapshots were ~99 % of the large allocations made while serving; on memory fragmented by days of use those made the driver fall back from large pages and the kernel reclaim and compact. With the pool, memory that had served for hours behaved like freshly sorted memory under the stress panel.",
    "memory_floor": "the admission floor drops from 8 GiB to 4 GiB of available memory (allowed only with the pool)",
    "cache_budgets": "cache 6 GiB -> 6.75 GiB, shared inactive images 7 GiB -> 7.75 GiB (within the pool)",
    "fix": "a restore that checks a cached snapshot out now reserves its room against the cache budget as well as the shared one; before, a save made while the snapshot was out could take its room and the engine stopped (never seen in production; reached in a stress test once a candidate eviction order kept long conversations cached). A remaining gap is handled by the cache policy instead of stopping."
  },
  "unchanged": [
    "weights",
    "kernels and numeric code",
    "every other setting of s1586",
    "2350 MHz clock policy",
    "the response timing contract",
    "portable profile"
  ],
