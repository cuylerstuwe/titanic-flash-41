+// Callers change policy at a synchronized boundary. Different peers may select
+// different banks safely: both destination QPs are connected to the same MR.
+int roce_set_small_packet_threshold(roce_ctx_t *c, uint32_t bytes) {
+    if (bytes > c->slot_bytes || bytes % 16 != 0) return -1;
+    atomic_store_explicit(&c->small_packet_threshold, bytes, memory_order_relaxed);
+    return 0;
+}
